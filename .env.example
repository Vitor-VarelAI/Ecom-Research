# Meta Ad Library API
# Cria uma app em https://developers.facebook.com/
# Token com permissão ads_read
META_ACCESS_TOKEN=your_meta_access_token_here

# SerpAPI key
# Regista-te em https://serpapi.com/ (free tier: 250 searches/mês)
SERPAPI_KEY=your_serpapi_key_here

# Telegram bridge (opcional, só para send_digest)
# O bot token e chat ID para enviar o digest diário
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Firecrawl (opcional, Delta B — preço de landings JS-pesadas)
# Regista-te em https://firecrawl.dev/ (free tier: 1.000 credits/mês)
# Só usado quando o fetch HTTP normal não encontra preço. 1 credit/scrape.
FIRECRAWL_KEY=your_firecrawl_key_here
