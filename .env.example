# Apify Facebook Ad Library actor
# Cria um token em https://console.apify.com/
# A pipeline chama curious_coder~facebook-ads-library-scraper uma vez por keyword.
APIFY_API_TOKEN=your_apify_api_token_here

# SerpAPI key
# Regista-te em https://serpapi.com/ (free tier: 250 searches/mês)
SERPAPI_KEY=your_serpapi_key_here

# Telegram outbound (opcional)
# Manter html até validar Rich num chat de teste; rich|html controla novos batches.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_RENDERER=html

# Firecrawl (opcional, Delta B — preço de landings JS-pesadas)
# Regista-te em https://firecrawl.dev/ (free tier: 1.000 credits/mês)
# Só usado quando o fetch HTTP normal não encontra preço. 1 credit/scrape.
FIRECRAWL_KEY=your_firecrawl_key_here

# Offer + Creative Arbitrage (opcional; apenas usado por --validate-offer)
# A validação chama DataForSEO através do OpenSEO e pode gerar custo DataForSEO.
OPENSEO_PROJECT_ID=
# Endpoint MCP local do OpenSEO. Pode ser substituído por --openseo-mcp-url.
OPENSEO_MCP_URL=http://127.0.0.1:3001/mcp
